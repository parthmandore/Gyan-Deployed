# =============================================================================
# Gyan Educational Application — Environment Configuration
# =============================================================================

# Speech-to-Text API URL (FastAPI + Whisper Backend)
# Default for Web and iOS Simulator:
EXPO_PUBLIC_STT_API_URL=http://localhost:8000

# For Physical Mobile Devices (Expo Go on Android / iOS via Wi-Fi):
# Set this to your development computer's local LAN IP:
# EXPO_PUBLIC_STT_API_URL=http://192.168.1.100:8000

# Main Gyan Backend API
EXPO_PUBLIC_API_URL=http://localhost:3000
